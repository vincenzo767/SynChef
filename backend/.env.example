# SynChef backend environment. Copy to backend/.env for local development
# (that file is git-ignored and imported automatically by application.properties).
# In production, provide these as real environment variables / secrets.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/SynChef
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Sessions / cookies. Keep APP_COOKIE_SECURE=true whenever the site is served over HTTPS.
# (Browsers accept Secure cookies on http://localhost, so true also works locally.)
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_SESSION_TTL=P7D
APP_SESSION_IDLE_TIMEOUT=PT48H
# Only needed when the SPA is served from a different origin than the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Sign-In (OAuth client ID — public identifier, not a secret)
GOOGLE_CLIENT_ID=

# Optional: bootstrap an administrator on first start (both required)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Optional: AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

APP_UPLOAD_DIR=uploads
APP_LOG_LEVEL=INFO
