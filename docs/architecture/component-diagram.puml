@startuml
skinparam componentStyle rectangle

' SynChef Component Diagram - current implementation
' React/Vite web client, Kotlin Android client, Spring Boot backend, PostgreSQL, WebSocket sync, local uploads, and external country/auth services

package "Clients" {
  component "Web Frontend\n(React / Vite)" as Web
  component "Android Mobile App\n(Kotlin / XML)" as Mobile
}

package "Web Frontend Runtime" {
  component "Local Recipe Dataset\n(ALL_RECIPES)" as LocalRecipes
  component "REST Client Layer\n(api/index.js + apiClient)" as FrontendApi
  component "Auth / UI State\n(Redux slices)" as FrontendState
}

package "Backend API (Spring Boot)" {
  component "Security + Auth\n(SecurityConfig, JwtTokenProvider, AuthService)" as Auth
  component "Recipe API\n(RecipeController, RecipeScalingService, TimerOrchestrationService)" as Recipe
  component "Country API\n(CountryController)" as Country
  component "User API\n(UserController, ProfileImageStorageService, NotificationService)" as User
  component "SynCook Community\n(SynCookController)" as SynCook
  component "AI Assistant API\n(AIController, AIAssistantService)" as AI
  component "Report + Admin API\n(RecipeReportController, AdminController, AdminService)" as Admin
  component "Timer Sync\n(TimerWebSocketController, WebSocketConfig)" as TimerWS
  component "JPA Persistence Layer\n(Repositories / Entities)" as Repo
  component "Static Upload Mapping\n(WebConfig / uploads)" as Uploads
}

database "PostgreSQL" as DB

cloud "External Services" {
  component "REST Countries API" as RestCountries
  component "Google OAuth / Identity" as Google
}

cloud "Local Storage" {
  component "Profile Image Files\n/uploads" as FileStore
}

' Client-to-client and frontend-to-external flows
Web --> FrontendApi : HTTP/HTTPS requests
Web --> LocalRecipes : instant local recipe browsing
Web --> RestCountries : country metadata for Flavor Map
Mobile --> FrontendApi : Retrofit / HTTP

FrontendApi --> Auth : /api/auth/*
FrontendApi --> Recipe : /api/recipes/*
FrontendApi --> Country : /api/countries/*
FrontendApi --> User : /api/users/me/*
FrontendApi --> SynCook : /api/syncook/*
FrontendApi --> AI : /api/ai/*
FrontendApi --> Admin : /api/admin/*, /api/reports

' Backend internal flow
Auth --> Google : verify Google login token
Auth --> Repo : users, roles, sessions
Recipe --> Repo : recipes, ingredients, steps, countries
Country --> Repo : countries, traditional ingredients
User --> Repo : profile, favorites, notifications
SynCook --> Repo : shared recipes, comments
AI --> Repo : recipe and ingredient context
Admin --> Repo : stats, moderation, analytics
TimerWS --> Repo : timer session events
Recipe --> TimerWS : timer-sequence sync
SynCook --> User : comment notifications
Admin --> User : report / moderation notifications

' Persistence and storage
Repo --> DB : JPA / SQL
User --> Uploads : profile image upload path
Uploads --> FileStore : stored files served as static resources

' Real-time timer updates
TimerWS --> Web : STOMP / WebSocket updates
TimerWS --> Mobile : STOMP / WebSocket updates

note right of FrontendApi
  Proof of implementation in the web app:
  - Login/register and JWT refresh
  - Recipe browsing, scaling, and cooking mode
  - SynCook dashboard, reports, admin screens
  - Profile, favorites, notifications
end note

note left of Recipe
  The recipe flow is layered:
  controller -> service -> repository -> PostgreSQL
  with timer sequences and scaled servings returned to the UI.
end note

note bottom of DB
  PostgreSQL stores the canonical backend data:
  users, recipes, countries, SynCook posts, comments, reports,
  favorites, and notifications.
end note

@enduml
