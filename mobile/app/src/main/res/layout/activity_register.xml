<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hero background photo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hero_chef_mobile"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_overlay" />

    <!-- Scrollable content sits below status bar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- ── Auth Card ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_card"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Create Account"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="Join our culinary community"
                    android:textColor="#CCF5F5F5"
                    android:textSize="13sp" />

                <!-- Error banner -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#33EF4444"
                    android:padding="10dp"
                    android:textColor="#FCA5A5"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Full Name label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Full Name"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Full Name input -->
                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="John Doe"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- Email Address label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Email Address"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Email input -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- Password label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Password"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Password input -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="At least 8 characters"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Must be at least 8 characters long"
                    android:textColor="#80F5F5F5"
                    android:textSize="11sp" />

                <!-- Confirm Password label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Confirm Password"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Confirm Password input -->
                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Confirm your password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- Country label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Country"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Country spinner -->
                <Spinner
                    android:id="@+id/spCountry"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input"
                    android:paddingHorizontal="8dp" />

                <!-- Terms checkbox -->
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:buttonTint="@color/synchef_violet"
                    android:text="I agree to the Terms of Service and Privacy Policy"
                    android:textColor="#CCF5F5F5"
                    android:textSize="12sp" />

                <!-- Create Account button -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_violet"
                    android:stateListAnimator="@null"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Go to Login -->
                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Already have an account?  Sign in"
                    android:textColor="@color/synchef_link"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Social divider hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp"
                    android:text="or continue with"
                    android:textColor="#80F5F5F5"
                    android:textSize="11sp" />

                <!-- Social buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnGoogle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_social"
                        android:stateListAnimator="@null"
                        android:text="G  Google"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnFacebook"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_social"
                        android:stateListAnimator="@null"
                        android:text="f  Facebook"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
